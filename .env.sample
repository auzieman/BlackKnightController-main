# BlackKnightController example environment
#
# Copy this file to .env or /srv/bkc/.env and replace every secret or host value
# with values for your lab. Do not commit real .env files.

# First-login bootstrap account. Remove BKC_BOOTSTRAP_ADMIN_PASSWORD after the
# first operator account exists.
BKC_BOOTSTRAP_ADMIN_USERNAME=admin
BKC_BOOTSTRAP_ADMIN_PASSWORD=change-this-demo-password

# Flask/session secret. Generate a real one with:
#   openssl rand -hex 32
BKC_SECRET_KEY=replace-with-64-hex-characters-from-openssl-rand

# Redis-backed rate limits and background jobs.
BKC_RATELIMIT_STORAGE_URI=redis://redis:6379/0
BKC_JOB_QUEUE_URL=redis://redis:6379/2

# Mounted runtime library paths inside the container.
BKC_PIPELINE_FOLDERS_PATH=/app/runtime/pipelines
BKC_PIPELINE_DEFINITIONS_PATH=/app/runtime/pipelines

# Reverse proxy / observability defaults.
BKC_BEHIND_PROXY=1
BKC_ACCESS_LOG_FORMAT=json

# Optional remote Docker target for lab automation. Leave blank for local Docker.
# Example:
#   DOCKER_HOST=ssh://root@swarm1.example.local
DOCKER_HOST=

# Optional kubeconfig path inside the container if Kubernetes automation is used.
KUBECONFIG=/app/runtime/kube/config
