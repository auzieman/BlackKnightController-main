{% extends 'base.html.j2' %}
{% from '_macros.html.j2' import csrf_field %}

{% block title %}Pipelines{% endblock %}
{% block page_heading %}Pipelines{% endblock %}

{% block head_extra %}{% endblock %}

{% block content %}
    <section class="pipeline-card pipeline-console-filter">
        <div class="pipeline-card-top">
            <div>
                <p class="eyebrow">Pipeline console</p>
                <h3>Catalog, selected lane, runs, and draft creation</h3>
            </div>
            <div class="pipeline-run-meta">
                <span class="status-pill muted">{{ pipelines|length }} lanes</span>
                <span class="status-pill muted">{{ runs|length }} runs</span>
                <span class="status-pill muted">{{ candidates|length }} candidates</span>
            </div>
        </div>
        <form method="get" class="pipeline-filter-form top-gap-sm">
            <label>
                Search
                <input type="text" name="q" value="{{ search_query }}" placeholder="name, repo, workflow, stage">
            </label>
            <label>
                Tag
                <select name="tag">
                    <option value="">all</option>
                    {% for tag in available_tags %}
                        <option value="{{ tag }}" {% if selected_tag == tag %}selected{% endif %}>{{ tag }}</option>
                    {% endfor %}
                </select>
            </label>
            <div class="pipeline-card-actions">
                <button class="button" type="submit">Apply</button>
                <a class="button button-quiet" href="{{ url_for('pipelines.pipelines') }}">Reset</a>
            </div>
        </form>
        <div id="pipeline-catalog-live-notice"
             class="workflow-empty top-gap-sm"
             hidden
             data-signature="{{ catalog_signature|tojson|forceescape }}"
             data-endpoint="{{ url_for('pipelines.pipeline_catalog_signature_api') }}">
            Pipeline catalog files changed. <a href="{{ request.full_path }}">Refresh pipeline view</a>
        </div>
    </section>

    <section class="pipeline-console-layout top-gap">
        <aside class="pipeline-console-tree">
            <div class="pipeline-console-heading">
                <p class="eyebrow">Catalog tree</p>
                <strong>{{ pipelines|length }} visible</strong>
            </div>
            <div class="pipeline-tree-list">
                {% for pipeline in pipelines %}
                    {% set latest = latest_runs_by_pipeline_key.get('pipeline:' ~ pipeline.id) or latest_runs_by_pipeline_key.get('workflow:' ~ pipeline.workflow) %}
                    {% set supported = supported_workflows.get(pipeline.workflow) %}
                    <a class="pipeline-tree-node{% if selected_pipeline and selected_pipeline.id == pipeline.id %} active{% endif %}"
                       href="{{ url_for('pipelines.pipelines', q=search_query, tag=selected_tag, pipeline=pipeline.id) }}">
                        <span class="pipeline-tree-status status-{{ (latest.status if latest else ('planned' if not supported else 'idle'))|lower|replace(' ', '-') }}"></span>
                        <strong>{{ pipeline.name }}</strong>
                        <small>{{ pipeline.repo }} · {{ pipeline.workflow }}</small>
                    </a>
                {% else %}
                    <div class="workflow-empty">No lanes match this filter.</div>
                {% endfor %}
            </div>

            <div class="pipeline-console-heading top-gap">
                <p class="eyebrow">Create</p>
                <strong>Draft lanes</strong>
            </div>
            <div class="pipeline-tree-list">
                {% for candidate in candidates[:6] %}
                    <form method="post" class="pipeline-candidate-row">
                        {{ csrf_field() }}
                        <input type="hidden" name="action" value="create-candidate-pipeline">
                        <input type="hidden" name="candidate_id" value="{{ candidate.id }}">
                        <button type="submit">
                            <strong>{{ candidate.name }}</strong>
                            <small>{{ candidate.source }} · {{ candidate.kind }}</small>
                        </button>
                    </form>
                {% else %}
                    <div class="workflow-empty">No candidates match this filter.</div>
                {% endfor %}
            </div>
        </aside>

        <section class="pipeline-console-main">
            {% if selected_pipeline %}
                {% set latest = latest_runs_by_pipeline_key.get('pipeline:' ~ selected_pipeline.id) or latest_runs_by_pipeline_key.get('workflow:' ~ selected_pipeline.workflow) %}
                {% set supported = supported_workflows.get(selected_pipeline.workflow) %}
                <article class="pipeline-card pipeline-selected-card">
                    <div class="pipeline-card-top">
                        <div>
                            <p class="eyebrow">{{ selected_pipeline.repo }}</p>
                            <h3>{{ selected_pipeline.name }}</h3>
                        </div>
                        <span class="status-pill {% if latest %}muted{% endif %}">
                            {% if supported %}
                                {{ latest.status if latest else 'not started' }}
                            {% else %}
                                planned
                            {% endif %}
                        </span>
                    </div>
                    <p class="metric-copy">{{ selected_pipeline.description }}</p>

                    <section class="pipeline-ai-explainer" aria-label="Ollama pipeline explainer">
                        <div>
                            <p class="eyebrow">Ollama explainer</p>
                            <h4>Operator brief for this pipeline</h4>
                            <p class="metric-copy">
                                Ask the lab model to summarize intent, destructive scope, dependencies, expected outputs, and safe rerun notes before you press the shiny button.
                            </p>
                        </div>
                        <div class="pipeline-ai-controls">
                            <label>
                                <span>model</span>
                                <select id="pipeline-ollama-model">
                                    <option value="qwen2.5-coder:1.5b">qwen2.5-coder:1.5b</option>
                                    <option value="llama3.2:3b">llama3.2:3b</option>
                                    <option value="granite3.2-vision">granite3.2-vision</option>
                                    <option value="hemanth/diagramgenerator">diagramgenerator</option>
                                </select>
                            </label>
                            <button
                                class="button button-secondary"
                                id="pipeline-ollama-explain"
                                type="button"
                                data-pipeline-id="{{ selected_pipeline.id }}"
                                data-explain-url="{{ url_for('pipelines.pipeline_explain_api') }}"
                            >Explain</button>
                        </div>
                        <pre id="pipeline-ollama-output" class="pipeline-ai-output" aria-live="polite">Select Explain to generate a grounded, pipeline-specific operator brief.</pre>
                    </section>

                    <div class="tab-strip pipeline-tabs">
                        <a class="tab-link active" href="#pipeline-summary">Summary</a>
                        <a class="tab-link" href="#pipeline-run-map">Run Map</a>
                        <a class="tab-link" href="#pipeline-stages">Stages</a>
                        <a class="tab-link" href="#pipeline-actions">Actions</a>
                        <a class="tab-link" href="#pipeline-runs">Runs</a>
                        <a class="tab-link" href="{{ url_for('pipelines.pipeline_edit', pipeline_id=selected_pipeline.id) }}">Edit</a>
                    </div>

                    <section id="pipeline-summary" class="pipeline-console-section">
                        <div class="pipeline-summary-grid">
                            <div>
                                <p class="eyebrow">Identity</p>
                                <dl class="fact-list">
                                    <div><dt>workflow</dt><dd>{{ selected_pipeline.workflow }}</dd></div>
                                    <div><dt>repo</dt><dd>{{ selected_pipeline.repo }}</dd></div>
                                    <div><dt>stage count</dt><dd>{{ selected_pipeline.stages|length }}</dd></div>
                                    <div><dt>executor</dt><dd>{{ 'wired' if supported else 'planned' }}</dd></div>
                                    <div><dt>source</dt><dd>{{ selected_pipeline.source_type or 'legacy-catalog' }}</dd></div>
                                    {% if selected_pipeline.source_path %}
                                        <div><dt>source path</dt><dd>{{ selected_pipeline.source_path }}</dd></div>
                                    {% endif %}
                                </dl>
                            </div>
                            <div>
                                <p class="eyebrow">Latest run</p>
                                {% if latest %}
                                    <dl class="fact-list">
                                        <div><dt>run</dt><dd><a href="{{ url_for('pipelines.pipeline_run_detail', run_id=latest.id) }}">{{ latest.id[:8] }}</a></dd></div>
                                        <div><dt>status</dt><dd>{{ latest.status }}</dd></div>
                                        <div><dt>stages</dt><dd>{{ latest.stage_summary.complete }} complete / {{ latest.stages|length }}</dd></div>
                                        <div><dt>updated</dt><dd>{{ latest.updated_at }}</dd></div>
                                    </dl>
                                {% else %}
                                    <p class="metric-copy">No run has been recorded for this lane yet.</p>
                                {% endif %}
                            </div>
                        </div>
                        {% if selected_pipeline.source_layers %}
                            <div class="resource-panel wide top-gap-sm">
                                <p class="eyebrow">Source layers</p>
                                <div class="constraint-list">
                                    {% for layer in selected_pipeline.source_layers %}
                                        <span>{{ layer.source_type }} · {{ layer.source_path }}</span>
                                    {% endfor %}
                                </div>
                            </div>
                        {% endif %}
                        {% if selected_dictionary %}
                            <div class="resource-panel wide top-gap-sm">
                                <div class="pipeline-card-top">
                                    <div>
                                        <p class="eyebrow">Resolved dictionary</p>
                                        <h4>{{ selected_dictionary['values']|length }} values</h4>
                                    </div>
                                    {% if selected_dictionary['missing'] %}
                                        <span class="status-pill failed">{{ selected_dictionary['missing']|length }} missing</span>
                                    {% else %}
                                        <span class="status-pill muted">ready</span>
                                    {% endif %}
                                </div>
                                {% if selected_dictionary['layers'] %}
                                    <div class="constraint-list top-gap-sm">
                                        {% for layer in selected_dictionary['layers'] %}
                                            <span>{{ layer['name'] }} · {{ layer['keys']|length }} keys</span>
                                        {% endfor %}
                                    </div>
                                {% endif %}
                                {% if selected_dictionary['missing'] %}
                                    <div class="workflow-empty top-gap-sm">Missing required values: {{ selected_dictionary['missing']|join(', ') }}</div>
                                {% endif %}
                                <dl class="fact-list top-gap-sm">
                                    {% for key, value in selected_dictionary['values'].items()|sort %}
                                        <div>
                                            <dt>{{ key }}</dt>
                                            <dd>{{ value if value not in [true, false] else ('true' if value else 'false') }}</dd>
                                        </div>
                                    {% else %}
                                        <div>
                                            <dt>status</dt>
                                            <dd>No dictionary values resolved.</dd>
                                        </div>
                                    {% endfor %}
                                </dl>
                            </div>
                        {% endif %}
                    </section>

                    <section id="pipeline-run-map" class="pipeline-console-section">
                        <div class="pipeline-card-top">
                            <div>
                                <p class="eyebrow">Execution map</p>
                                <h4>{{ selected_run_map.run.id[:8] if selected_run_map.run else 'Next run preview' }}</h4>
                            </div>
                            <span class="status-pill muted">{{ selected_run_map.stages|length }} stages</span>
                        </div>
                        <div class="pipeline-run-map">
                            {% for stage in selected_run_map.stages %}
                                <article class="run-map-stage status-{{ stage.status|lower|replace(' ', '-') }}">
                                    <div class="run-map-stage-top">
                                        <span>{{ loop.index }}</span>
                                        <strong>{{ stage.name }}</strong>
                                    </div>
                                    <div class="run-map-state">
                                        <span class="run-map-light"></span>
                                        <span>{{ stage.status }}</span>
                                    </div>
                                    {% if stage.targets %}
                                        <div class="run-map-targets">
                                            {% for target in stage.targets %}
                                                <span>{{ target }}</span>
                                            {% endfor %}
                                        </div>
                                    {% endif %}
                                    {% if stage.action %}
                                        <a class="run-map-action" href="{{ url_for('resource_graph.resource_graph', resource='action:' ~ stage.action) }}">{{ stage.action }}</a>
                                    {% endif %}
                                    {% if stage.detail %}
                                        <p>{{ stage.detail }}</p>
                                    {% endif %}
                                </article>
                            {% else %}
                                <div class="workflow-empty">No stages are available for this lane yet.</div>
                            {% endfor %}
                        </div>
                    </section>

                    <section id="pipeline-stages" class="pipeline-console-section">
                        <p class="eyebrow">Stage recipe</p>
                        <div class="pipeline-stage-table">
                            {% for stage in selected_pipeline.stages %}
                                <div>
                                    <span>{{ loop.index }}</span>
                                    <strong>{{ stage }}</strong>
                                </div>
                            {% endfor %}
                        </div>
                    </section>

                    <section id="pipeline-actions" class="pipeline-console-section">
                        <p class="eyebrow">Action bricks</p>
                        <div class="pipeline-stage-row">
                            {% for action in selected_pipeline.actions %}
                                <a class="pipeline-stage-chip compact-chip" href="{{ url_for('resource_graph.resource_graph', resource='action:' ~ action) }}">{{ action }}</a>
                            {% else %}
                                <span class="pipeline-stage-chip compact-chip">action catalog pending</span>
                            {% endfor %}
                        </div>
                    </section>

                    <section id="pipeline-runs" class="pipeline-console-section">
                        <form method="post" class="pipeline-trigger-form">
                            {{ csrf_field() }}
                            <input type="hidden" name="pipeline_id" value="{{ selected_pipeline.id }}">
                            <label>
                                Ref
                                <input type="text" name="ref" value="refs/heads/main">
                            </label>
                            <label>
                                Commit
                                <input type="text" name="commit" placeholder="optional commit sha">
                            </label>
                            {% for input_name, input_spec in selected_pipeline.inputs.items() %}
                                {% if input_spec.default in [true, false] %}
                                    <label class="pipeline-boolean-input">
                                        <input type="checkbox" name="input__{{ input_name }}" value="true" {% if input_spec.default %}checked{% endif %}>
                                        {{ input_name|replace('_', ' ') }}
                                    </label>
                                {% elif input_name != 'tenant_slug' %}
                                    <label>
                                        {{ input_name|replace('_', ' ') }}
                                        <input type="text" name="input__{{ input_name }}" value="{{ input_spec.default }}" {% if input_spec.required %}required{% endif %}>
                                    </label>
                                {% endif %}
                            {% endfor %}
                            {% if selected_pipeline.workflow in ['fedora-cosmic-postinstall', 'demo-k3s-add-node'] %}
                                <label>
                                    Target host
                                    <input type="text" name="target_host" placeholder="{{ '192.168.1.129' if selected_pipeline.workflow == 'fedora-cosmic-postinstall' else '192.168.1.x' }}">
                                </label>
                                <label>
                                    Target VMID
                                    <input type="text" name="target_vmid" placeholder="optional">
                                </label>
                                <label class="wide">
                                    Target name
                                    <input type="text" name="target_name" placeholder="{{ 'fedora-template-118' if selected_pipeline.workflow == 'fedora-cosmic-postinstall' else 'kube3' }}">
                                </label>
                            {% endif %}
                            <label class="wide">
                                Notes
                                <textarea name="notes" rows="3" placeholder="{{ selected_pipeline.notes }}"></textarea>
                            </label>
                            <div class="pipeline-card-actions">
                                <button class="button" type="submit" {% if not supported %}disabled{% endif %}>
                                    {{ 'Queue Run' if supported else 'Planned Lane' }}
                                </button>
                                <a class="button button-quiet" href="{{ url_for('pipelines.pipeline_edit', pipeline_id=selected_pipeline.id) }}">Edit Lane</a>
                            </div>
                        </form>
                    </section>

                    <div class="pipeline-inline-links">
                        {% for link in selected_pipeline.links %}
                            <a class="button button-quiet" href="{{ link.url }}">{{ link.label }}</a>
                        {% endfor %}
                    </div>
                </article>
            {% else %}
                <section class="group-card empty-state">
                    <h4>No lane selected</h4>
                    <p>Clear the search or tag filter to see the catalog.</p>
                </section>
            {% endif %}
        </section>
    </section>

    <section class="section-header">
        <div>
            <p class="eyebrow">Recent automation runs</p>
            <h3>Pipeline ledger</h3>
            <p class="section-copy">Showing the latest run per pipeline. {{ raw_run_count }} matching run records remain available from each run detail.</p>
        </div>
    </section>

    <section class="pipeline-run-list">
        {% for run in runs %}
            <article class="pipeline-run-card">
                <div class="pipeline-card-top">
                    <div>
                        <p class="eyebrow">{{ run.repo }}</p>
                        <h3>{{ run.workflow }}</h3>
                    </div>
                    <span class="status-pill">{{ run.status }}</span>
                </div>
                <p class="metric-copy">{{ run.notes or 'no notes' }}</p>
                <div class="pipeline-run-meta">
                    <span class="status-pill muted">Run {{ run.id[:8] }}</span>
                    <span class="status-pill muted">{{ run.attempt_count }} attempt{% if run.attempt_count != 1 %}s{% endif %}</span>
                    {% if run.previous_attempt_count %}
                        <span class="status-pill muted">{{ run.previous_attempt_count }} earlier</span>
                    {% endif %}
                    {% if run.failed_attempt_count %}
                        <span class="status-pill muted">{{ run.failed_attempt_count }} failed</span>
                    {% endif %}
                    <span class="status-pill muted">{{ run.ref or 'ref unset' }}</span>
                    {% if run.commit %}
                        <span class="status-pill muted">{{ run.commit[:12] }}</span>
                    {% endif %}
                    {% for tag in run.tags %}
                        <span class="pipeline-stage-chip compact-chip">{{ tag }}</span>
                    {% endfor %}
                </div>
                <div class="pipeline-stage-board">
                    {% for stage in run.stages %}
                        <div class="pipeline-stage-status status-{{ stage.status|lower|replace(' ', '-') }}">
                            <strong>{{ stage.name }}</strong>
                            <span>{{ stage.status }}</span>
                            {% if stage.detail %}
                                <small>{{ stage.detail }}</small>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
                {% set last_event = (run.events|default([], true)|last) %}
                <div class="pipeline-run-summary">
                    {% if last_event %}
                        <span class="status-pill muted">{{ last_event.at }}</span>
                        <span class="status-pill muted">{{ last_event.stage }}</span>
                        <span class="metric-copy">{{ last_event.message }}</span>
                    {% else %}
                        <span class="metric-copy">No events recorded yet.</span>
                    {% endif %}
                </div>
                <div class="pipeline-card-actions top-gap-sm">
                    <a class="button" href="{{ url_for('pipelines.pipeline_run_detail', run_id=run.id) }}">Open Run</a>
                    <a class="button button-quiet" href="{{ url_for('pipelines.pipeline_edit', pipeline_id=run.extra.pipeline_id) }}">Edit Lane</a>
                    <form method="post" action="{{ url_for('pipelines.pipeline_run_action', run_id=run.id) }}" class="inline-action-form">
                        {{ csrf_field() }}
                        <input type="hidden" name="action" value="retry">
                        <button class="button button-quiet" type="submit">Retry</button>
                    </form>
                    <form method="post" action="{{ url_for('pipelines.pipeline_run_action', run_id=run.id) }}" class="inline-action-form">
                        {{ csrf_field() }}
                        <input type="hidden" name="action" value="redeploy">
                        <button class="button button-quiet" type="submit">Redeploy</button>
                    </form>
                    {% if run.supports_undeploy %}
                        <form method="post" action="{{ url_for('pipelines.pipeline_run_action', run_id=run.id) }}" class="inline-action-form">
                            {{ csrf_field() }}
                            <input type="hidden" name="action" value="undeploy">
                            <button class="button button-quiet" type="submit">Undeploy</button>
                        </form>
                    {% endif %}
                </div>
            </article>
        {% else %}
            <section class="group-card empty-state">
                <h4>No automation runs yet</h4>
                <p>Queue a demo lane above to start building the run ledger.</p>
            </section>
        {% endfor %}
    </section>

    <script>
        (function () {
            const explainButton = document.getElementById("pipeline-ollama-explain");
            const explainOutput = document.getElementById("pipeline-ollama-output");
            const modelSelect = document.getElementById("pipeline-ollama-model");
            const csrfToken = document.querySelector("meta[name='csrf-token']")?.getAttribute("content") || "";
            if (explainButton && explainOutput && modelSelect) {
                explainButton.addEventListener("click", async () => {
                    const originalText = explainButton.textContent;
                    explainButton.disabled = true;
                    explainButton.textContent = "Thinking…";
                    explainOutput.textContent = "Asking the lab Ollama host for a short operator brief…";
                    try {
                        const response = await fetch(explainButton.dataset.explainUrl, {
                            method: "POST",
                            headers: {
                                "Accept": "application/json",
                                "Content-Type": "application/json",
                                ...(csrfToken ? {"X-CSRFToken": csrfToken} : {}),
                            },
                            body: JSON.stringify({
                                pipeline_id: explainButton.dataset.pipelineId,
                                model: modelSelect.value,
                            }),
                        });
                        const data = await response.json();
                        if (!response.ok) {
                            throw new Error(data.error || `HTTP ${response.status}`);
                        }
                        const source = data.source === "ollama" ? "Ollama" : "local fallback";
                        explainOutput.textContent = `[${source} · ${data.model}]\n\n${data.explanation}`;
                    } catch (error) {
                        explainOutput.textContent = `Explainer failed cleanly: ${error.message}`;
                    } finally {
                        explainButton.disabled = false;
                        explainButton.textContent = originalText;
                    }
                });
            }

            const notice = document.getElementById("pipeline-catalog-live-notice");
            if (!notice || !window.fetch) {
                return;
            }
            let current = {};
            try {
                current = JSON.parse(notice.dataset.signature || "{}");
            } catch (error) {
                current = {};
            }
            const endpoint = notice.dataset.endpoint;
            function sameSignature(next) {
                return next
                    && next.file_count === current.file_count
                    && next.newest_mtime_ns === current.newest_mtime_ns
                    && next.total_size === current.total_size
                    && next.pipeline_count === current.pipeline_count;
            }
            async function pollCatalog() {
                try {
                    const response = await fetch(endpoint, {
                        headers: { "Accept": "application/json" },
                        credentials: "same-origin"
                    });
                    if (!response.ok) {
                        return;
                    }
                    const next = await response.json();
                    if (!sameSignature(next)) {
                        notice.hidden = false;
                    }
                } catch (error) {
                    // Polling is advisory. The normal page request still loads live catalog state.
                }
            }
            window.setInterval(pollCatalog, 8000);
        }());
    </script>
{% endblock %}
