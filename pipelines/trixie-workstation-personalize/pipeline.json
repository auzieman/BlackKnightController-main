{
  "format": "bkc-pipeline-v1",
  "id": "trixie-workstation-personalize",
  "name": "Trixie Workstation Personalize",
  "status": "draft",
  "owner": "bkc",
  "summary": "Personalize the installed Debian Trixie VMID 132 as a lightweight workstation without rerunning PXE.",
  "tags": [
    "bkc",
    "node-model",
    "debian",
    "trixie",
    "workstation",
    "postinstall",
    "runnable"
  ],
  "targets": {
    "target_vm": "node:vm:trixie-smoke-132"
  },
  "inputs": {
    "target_vmid": {
      "required": true,
      "default": 132
    }
  },
  "stages": [
    {
      "id": "discover-installed-trixie",
      "action": "proxmox.guest.exec",
      "transport": "bkc-proxmox",
      "risk": "low",
      "with": {
        "vmid": "${dictionary.target_vmid}",
        "command": "hostname; systemctl is-active qemu-guest-agent ssh"
      },
      "produces": [
        "fact:trixie_guest_ready"
      ],
      "timeout_seconds": 60
    },
    {
      "id": "install-workstation-packages",
      "action": "proxmox.guest.exec",
      "transport": "bkc-proxmox",
      "risk": "medium",
      "with": {
        "vmid": "${dictionary.target_vmid}",
        "packages": [
          "${dictionary.desktop_packages}",
          "${dictionary.developer_packages}"
        ]
      },
      "produces": [
        "package:libreoffice",
        "package:mate",
        "package:enlightenment",
        "package:developer-tools"
      ],
      "timeout_seconds": 3600
    },
    {
      "id": "install-vscode-if-enabled",
      "action": "proxmox.guest.exec",
      "transport": "bkc-proxmox",
      "risk": "medium",
      "with": {
        "vmid": "${dictionary.target_vmid}",
        "enabled": "${dictionary.enable_vscode}"
      },
      "produces": [
        "package:vscode"
      ],
      "timeout_seconds": 900
    },
    {
      "id": "install-rustdesk-if-configured",
      "action": "proxmox.guest.exec",
      "transport": "bkc-proxmox",
      "risk": "medium",
      "with": {
        "vmid": "${dictionary.target_vmid}",
        "url": "${dictionary.rustdesk_deb_url}",
        "enabled": "${dictionary.enable_rustdesk}"
      },
      "produces": [
        "package:rustdesk"
      ],
      "timeout_seconds": 900
    },
    {
      "id": "enable-graphical-services",
      "action": "proxmox.guest.exec",
      "transport": "bkc-proxmox",
      "risk": "medium",
      "with": {
        "vmid": "${dictionary.target_vmid}",
        "target": "${dictionary.graphical_target}"
      },
      "produces": [
        "service:graphical-target",
        "service:ssh",
        "service:qemu-guest-agent"
      ],
      "timeout_seconds": 120
    },
    {
      "id": "verify-trixie-personality",
      "action": "proxmox.guest.exec",
      "transport": "bkc-proxmox",
      "risk": "low",
      "with": {
        "vmid": "${dictionary.target_vmid}",
        "commands": [
          "dpkg-query -W libreoffice mate-desktop-environment-core enlightenment",
          "systemctl is-enabled ssh qemu-guest-agent"
        ]
      },
      "produces": [
        "fact:trixie_workstation_ready"
      ],
      "timeout_seconds": 120
    },
    {
      "id": "record-trixie-personality",
      "action": "node.relationships.record",
      "transport": "internal",
      "risk": "low",
      "with": {
        "relationships": [
          {
            "source_id": "${dictionary.target_vm_node_id}",
            "type": "has_profile",
            "target_id": "profile:workstation:trixie-mate-enlightenment",
            "confidence": "validated"
          }
        ]
      },
      "produces": [
        "relationship:trixie-workstation-profile"
      ],
      "timeout_seconds": 15
    }
  ]
}
