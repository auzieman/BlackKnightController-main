{
  "format": "bkc-pipeline-v1",
  "id": "auzix-package-repo-stripped-iso",
  "name": "LEGACY \u2014 AUZIX LAB 13 \u2014 Package Repo Deploy + Stripped ISO Proof",
  "repo": "BlackKnightController",
  "workflow": "auzix-package-repo-stripped-iso",
  "resource_class": "slow",
  "status": "retired",
  "tags": [
    "auzix",
    "packages",
    "package-repo",
    "iso",
    "strict-root",
    "ollama",
    "lab-build",
    "r730-ai-01",
    "legacy",
    "retired"
  ],
  "summary": "Rebuild/repack the AUZiX workstation package set on r730, enforce runtime/dependency audits, publish the repaired package repository, then leave stripped ISO work behind a separate gate.",
  "targets": {
    "tenant": "tenant:lab",
    "repo_host": "host:lab-build",
    "worker": "host:r730-ai-01",
    "source_repo": "repo:AuziX",
    "package_repo": "service:auzix-package-repo",
    "artifact_store": "service:ns1-nfs",
    "validation_target": "node:vm:auzix-vm135"
  },
  "inputs": {
    "repo_host": {
      "required": true,
      "default": "lab-build"
    },
    "repo_host_path": {
      "required": true,
      "default": "/home/admin-deploy/src/AuziX"
    },
    "worker_host": {
      "required": true,
      "default": "10.20.0.130"
    },
    "strict_root_path": {
      "required": true,
      "default": "/srv/bkc/auzix/src/out/auzix-strict/AuzixRoot"
    },
    "package_repo_dir": {
      "required": true,
      "default": "/srv/http/auzix/repo"
    },
    "artifact_handoff_path": {
      "required": true,
      "default": "/mnt/ns1/auzix/handoff/stripped-iso"
    },
    "candidate_iso_path": {
      "required": true,
      "default": "/srv/bkc/auzix/src/artifacts/auzix/auzix-strict-shell.iso"
    },
    "iso_profile": {
      "required": false,
      "default": "live-installer-demo"
    },
    "iso_profile_file": {
      "required": false,
      "default": "packages/live-installer-demo.profile.json"
    },
    "iso_package_profile_file": {
      "required": false,
      "default": "profiles/packages/auzix-live-installer-demo.packages"
    },
    "build_target": {
      "required": true,
      "default": "workstation-packages"
    },
    "make_target": {
      "required": true,
      "default": "auzix-workstation-package-rebuild"
    },
    "enable_package_build": {
      "required": false,
      "default": true
    },
    "enable_package_publish": {
      "required": false,
      "default": true
    },
    "enable_stripped_iso_build": {
      "required": false,
      "default": false
    },
    "enable_vm135_install_validation": {
      "required": false,
      "default": false
    },
    "enable_bkc_channel_post": {
      "required": false,
      "default": false
    }
  },
  "stages": [
    {
      "id": "preflight-lab-build-and-worker",
      "action": "bkc.hosts.probe",
      "transport": "bkc-ssh",
      "risk": "low",
      "timeout_seconds": 180
    },
    {
      "id": "sync-auzix-source-to-worker",
      "action": "repo.rsync.lab_build_to_target",
      "transport": "bkc-ssh",
      "risk": "low",
      "timeout_seconds": 600
    },
    {
      "id": "validate-package-intents",
      "action": "auzix.packages.intent.validate",
      "transport": "bkc-ssh",
      "risk": "low",
      "timeout_seconds": 240
    },
    {
      "id": "run-workstation-package-rebuild-on-r730",
      "action": "auzix.packages.workstation_rebuild",
      "transport": "bkc-ssh+docker",
      "risk": "medium",
      "enabled_by": "enable_package_build",
      "timeout_seconds": 28800,
      "with": {
        "runner": "scripts/run-auzix-live-build-r730.sh",
        "environment": {
          "AUZIX_BUILD_TARGET": "${inputs.build_target}",
          "AUZIX_PACKAGE_NORMALIZE_OWNERS": "0",
          "AUZIX_PUBLISH_UNVALIDATED_DESKTOP_ENTRIES": "0"
        }
      },
      "produces": [
        "out/package-rebuild/workstation-package-rebuild-*.summary",
        "out/package-bot/userspace-repair-*.json",
        "out/package-bot/trixie-user-apps-*.json",
        "artifacts/auzix/repo/index.json",
        "artifacts/auzix/package-metadata-risk.json"
      ]
    },
    {
      "id": "runtime-audit-package-repository",
      "action": "auzix.package_repo.runtime_dependency_audit",
      "transport": "bkc-ssh",
      "risk": "low",
      "timeout_seconds": 1800,
      "notes": "Hard gate: fails if command-bearing packages lack loader/library validation or declared dependency receipts."
    },
    {
      "id": "validate-package-repository",
      "action": "auzix.package_repo.validate_index_and_archives",
      "transport": "bkc-ssh",
      "risk": "low",
      "timeout_seconds": 600
    },
    {
      "id": "publish-package-repository",
      "action": "auzix.package_repo.publish",
      "transport": "bkc-ssh",
      "risk": "medium",
      "enabled_by": "enable_package_publish",
      "timeout_seconds": 900
    },
    {
      "id": "strict-root-no-classic-dir-audit",
      "action": "auzix.strict_root.audit",
      "transport": "bkc-ssh",
      "risk": "low",
      "timeout_seconds": 1800,
      "policy": {
        "legacy_top_level_paths": "invalid-unless-breakfix-fragment-exists"
      }
    },
    {
      "id": "ollama-review-package-and-root-receipts",
      "action": "ollama.receipts.triage",
      "transport": "http",
      "risk": "low",
      "timeout_seconds": 300,
      "input_policy": "receipts-only-no-secrets"
    },
    {
      "id": "ollama-select-smallest-rebuild-fix",
      "action": "ollama.receipts.select_one_failed_check",
      "transport": "http",
      "risk": "low",
      "timeout_seconds": 180
    },
    {
      "id": "build-stripped-install-iso",
      "action": "auzix.iso.build_live_installer_demo",
      "transport": "bkc-ssh",
      "risk": "medium",
      "enabled_by": "enable_stripped_iso_build",
      "timeout_seconds": 7200,
      "with": {
        "profile": "${inputs.iso_profile}",
        "profile_file": "${inputs.iso_profile_file}",
        "package_profile_file": "${inputs.iso_package_profile_file}",
        "non_goals": [
          "full workstation payload",
          "office suite in ISO",
          "Flatpak applications in ISO",
          "Podman demo image payloads in ISO"
        ]
      }
    },
    {
      "id": "validate-iso-publication-contract",
      "action": "auzix.iso.validate_publication_contract",
      "transport": "bkc-ssh",
      "risk": "low",
      "timeout_seconds": 600
    },
    {
      "id": "vm135-package-install-proof",
      "action": "auzix.vm135.package_install_from_repo",
      "transport": "bkc-ssh",
      "risk": "medium",
      "enabled_by": "enable_vm135_install_validation",
      "timeout_seconds": 2400
    },
    {
      "id": "publish-handoff-receipts",
      "action": "auzix.receipts.publish_handoff",
      "transport": "bkc-ssh",
      "risk": "low",
      "timeout_seconds": 300
    },
    {
      "id": "post-bkc-channel-progress",
      "action": "bkc_channel.progress.post",
      "transport": "internal",
      "risk": "low",
      "enabled_by": "enable_bkc_channel_post",
      "timeout_seconds": 120
    },
    {
      "id": "record-auzix-package-repo-iso-fragment",
      "action": "fragments.record",
      "transport": "internal",
      "risk": "low",
      "timeout_seconds": 60
    }
  ],
  "notes": "Package-factory pipeline. The default run rebuilds/repackages the workstation package set on r730, preserves ownership/modes, keeps unvalidated desktop launchers hidden, runs runtime dependency audits, and publishes the package repository. The ISO gate is now the live-installer-demo profile: graphical installer, xterm rescue terminal, browser, file manager, SSH, and debug/internet tools without embedding the full workstation. VM135 destructive validation and Auzietek/IONOS public mirroring remain separately gated.\n\nRetired from the active AUZiX factory path; retained for history/reference. Use AUZIX 21-25 for current package build, ISO pack, VM stage/reload, disk install, and product validation."
}
