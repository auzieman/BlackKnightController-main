{
  "tenant_slug": "lab",
  "openstack_host": "10.20.0.240",
  "admin_openrc": "/root/admin-openrc",
  "ai_project": "bkc-demo",
  "ai_network": "lab-internal",
  "ai_image": "debian-13-genericcloud",
  "ai_flavor": {
    "name": "bkc.ai.small",
    "ram_mb": 8192,
    "disk_gb": 40,
    "vcpus": 4
  },
  "ai_security_group": {
    "name": "bkc-local-ai-allow",
    "rules": [
      {"protocol": "icmp", "remote_ip_prefix": "10.20.0.0/24"},
      {"protocol": "tcp", "dst_port": 22, "remote_ip_prefix": "10.20.0.0/24"},
      {"protocol": "tcp", "dst_port": 8080, "remote_ip_prefix": "10.20.0.0/24"},
      {"protocol": "tcp", "dst_port": 11434, "remote_ip_prefix": "10.20.0.0/24"}
    ]
  },
  "ai_keypair": "bkc-demo-key",
  "ai_server": {
    "name": "bkc-local-ai-01",
    "user": "admin-deploy",
    "console_password": "changeme123",
    "ssh_password_auth": true,
    "root_disk_gb": 40
  },
  "ollama": {
    "install_mode": "baremetal-systemd",
    "bind": "127.0.0.1:11434",
    "model": "llama3.2:3b",
    "model_storage": "/var/lib/ollama",
    "enabled_by_default": true
  },
  "openwebui": {
    "install_mode": "container",
    "image": "ghcr.io/open-webui/open-webui:main",
    "listen": "0.0.0.0:8080",
    "public_url": "http://swarm1.lab.auzietek.com:8088",
    "ollama_base_url": "http://127.0.0.1:11434",
    "enabled_by_default": true
  },
  "known_good_fragments": [
    "openstack.resources.seed from 30 VIDEO",
    "small-office service stages for explicit service intent",
    "rx-demo deploy stages for artifact/build/deploy/validate rhythm"
  ]
}
