{
  "format": "bkc-pipeline-v1",
  "id": "auzix-release-hdd-build-deploy",
  "name": "AUZiX 33 — Validated HDD Build + PVE Deploy",
  "repo": "BlackKnightController",
  "workflow": "auzix-release-hdd-build-deploy",
  "resource_class": "slow",
  "status": "candidate",
  "tags": ["auzix", "r730", "hdd-image", "pve", "vm142", "release-gate"],
  "summary": "Resolve the bounded desktop package profile, install it into a sparse HDD through the existing AUZiX package-profile installer, and emit an immutable image receipt.",
  "operator_rule": "The full repository catalog must never become the HDD payload. Seed-runtime copying is disabled; package closure, archive size, hashes, and immutable source are mandatory gates.",
  "targets": {
    "worker": "host:r730-ai-01",
    "hypervisor": "host:pve",
    "target_vm": "node:vm:142",
    "protected_reference": "node:vm:135"
  },
  "inputs": {
    "hdd_id": {"required": true, "default": "desktop-main-20260828-r8"},
    "source_ref": {"required": true, "default": "auzix-alpha-package-profile-hdd-20260828-r4"},
    "target_vmid": {"required": true, "default": 142},
    "target_ip": {"required": false, "default": "192.168.1.229"},
    "storage": {"required": true, "default": "local-lvm"},
    "allow_protected_vmid": {"required": false, "default": false}
  },
  "stages": [
    {"id":"resolve-profile-and-preflight-seed","action":"auzix.release_hdd.preflight","transport":"bkc-ssh","risk":"low","timeout_seconds":300,"params":{"script":"scripts/build-validated-hdd.sh","mode":"preflight"}},
    {"id":"install-profile-into-sparse-hdd","action":"auzix.release_hdd.build","transport":"bkc-ssh","risk":"medium","timeout_seconds":7200,"params":{"script":"scripts/build-validated-hdd.sh","mode":"build"}}
  ],
  "outputs": {
    "image": "/var/lib/auzix-build/hdd-images/<hdd_id>/auzix-<hdd_id>.img",
    "receipt": "/var/lib/auzix-build/receipts/release-hdd-<hdd_id>.receipt",
    "target": "pve:vmid142"
  }
}
