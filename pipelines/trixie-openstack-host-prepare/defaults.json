{
  "tenant_slug": "lab",
  "target_hosts": [
    "r630-openstack-01",
    "r630-openstack-02"
  ],
  "target_transport": "bkc-ssh",
  "base_os_distribution": "debian",
  "base_os_version": "trixie",
  "openstack_network_mode": "ovs",
  "neutron_external_bridge": "br-ex",
  "neutron_physnet": "physnet1",
  "neutron_tunnel_types": [
    "vxlan"
  ],
  "openstack_host_packages": [
    "crudini",
    "curl",
    "jq",
    "iproute2",
    "conntrack",
    "ipset",
    "ebtables",
    "bridge-utils",
    "vlan",
    "openvswitch-switch",
    "neutron-common",
    "neutron-openvswitch-agent",
    "python3-openstackclient",
    "python3-neutronclient"
  ],
  "kernel_modules": [
    "br_netfilter",
    "openvswitch",
    "8021q"
  ],
  "sysctl_settings": {
    "net.bridge.bridge-nf-call-iptables": "1",
    "net.bridge.bridge-nf-call-ip6tables": "1",
    "net.ipv4.ip_forward": "1"
  },
  "prepare_script": "scripts/prepare-openstack-neutron-host.sh",
  "validate_script": "checks/validate-openstack-neutron-host.sh"
}
