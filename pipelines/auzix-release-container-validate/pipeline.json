{
  "format": "bkc-pipeline-v1",
  "id": "auzix-release-container-validate",
  "name": "AUZiX 32 — Fresh Release Container Validation",
  "repo": "BlackKnightController",
  "workflow": "auzix-release-container-validate",
  "resource_class": "slow",
  "status": "candidate",
  "tags": ["auzix", "r730", "container", "validation", "release-gate"],
  "summary": "Validate a frozen AUZiX release against an explicitly tagged source and a proved canonical base before building staged service and pre-HDD images.",
  "operator_rule": "Never use a mutable source ref or begin image construction until release hashes, canonical libc/libgcc surfaces, selected dependency closure, and embedded application runtime metadata pass preflight.",
  "targets": {
    "worker": "host:r730-ai-01",
    "repository": "artifact:auzix-consolidated-release",
    "artifact_store": "path:/var/lib/auzix-build/releases"
  },
  "inputs": {
    "release_id": {"required": true, "default": "trixie-consolidated-20260826-r1"},
    "validation_id": {"required": true, "default": "container-proof-r1"},
    "image": {"required": true, "default": "auzix/release-validation:trixie-r1"},
    "source_ref": {"required": true, "default": "auzix-alpha-base-runtime-repair-20260828-r2"},
    "worker_host": {"required": true, "default": "lab-ai-worker"},
    "selection": {"required": true, "default": "first-boot-cli"}
  },
  "stages": [
    {"id":"reload-authoritative-guardrails","action":"auzix.guardrails.reload","transport":"bkc-ssh","risk":"low","timeout_seconds":300},
    {"id":"preflight-build-and-validate-release-images","action":"auzix.release_container.build_and_validate","transport":"bkc-ssh+docker","risk":"medium","timeout_seconds":7200,"params":{"script":"scripts/build-three-release-containers.sh"}}
  ],
  "outputs": {
    "root": "/var/lib/auzix-build/releases/<release_id>/validation/<validation_id>/root",
    "report": "/var/lib/auzix-build/releases/<release_id>/validation/<validation_id>/validation-report.json",
    "receipt": "/var/lib/auzix-build/receipts/release-container-<validation_id>.receipt"
  },
  "follow_up_pipeline": "auzix-release-hdd-build-deploy"
}
