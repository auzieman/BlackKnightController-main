{
  "format": "bkc-pipeline-v1",
  "id": "trixie-openstack-package-smoke",
  "name": "Trixie OpenStack Package Smoke",
  "status": "draft",
  "owner": "bkc",
  "repo": "BlackKnightController",
  "summary": "Reuse or clone an existing Trixie VM, such as the SuiteCRM node, to smoke test OpenStack Neutron/Open vSwitch package and configuration steps without claiming bare-metal readiness.",
  "tags": [
    "bkc",
    "debian",
    "trixie",
    "openstack",
    "neutron",
    "openvswitch",
    "smoke",
    "foobar",
    "draft"
  ],
  "targets": {
    "tenant": "tenant:foobar",
    "target_vm": "node:vm:foobar-crm-01",
    "reused_pipeline": "trixie-openstack-host-prepare"
  },
  "inputs": {
    "tenant_slug": {
      "required": true,
      "default": "foobar"
    },
    "enable_existing_vm_reuse": {
      "required": false,
      "default": false
    },
    "enable_package_install": {
      "required": false,
      "default": false
    }
  },
  "gates": [
    {
      "id": "existing-vm-reuse-disabled-by-default",
      "kind": "manual.approval",
      "with": {
        "target": "${dictionary.target_node_id}",
        "warning": "${dictionary.reuse_warning}",
        "enable_existing_vm_reuse": "${inputs.enable_existing_vm_reuse}",
        "requires_explicit_true": true
      }
    }
  ],
  "stages": [
    {
      "id": "load-smoke-intent",
      "action": "recipe.intent.load",
      "transport": "internal",
      "risk": "low",
      "with": {
        "tenant_slug": "${inputs.tenant_slug}",
        "defaults": "defaults.json"
      },
      "produces": [
        "event:openstack_package_smoke.intent_loaded"
      ],
      "timeout_seconds": 15
    },
    {
      "id": "run-package-config-smoke",
      "action": "ssh.script.run",
      "transport": "bkc-ssh",
      "risk": "medium",
      "with": {
        "hosts": "${dictionary.target_hosts}",
        "script": "${dictionary.prepare_script}",
        "enabled": "${inputs.enable_package_install}",
        "environment": {
          "BKC_OPENSTACK_PACKAGES": "${dictionary.openstack_host_packages}",
          "BKC_NEUTRON_MODE": "${dictionary.openstack_network_mode}",
          "BKC_NEUTRON_EXTERNAL_BRIDGE": "${dictionary.neutron_external_bridge}",
          "BKC_NEUTRON_PHYSNET": "${dictionary.neutron_physnet}",
          "BKC_ENABLE_NETWORK_CONFIG": "${dictionary.enable_network_config}",
          "BKC_OPENSTACK_SMOKE_MODE": "${dictionary.smoke_mode}"
        }
      },
      "produces": [
        "event:openstack_package_smoke.packages_installed",
        "evidence:openstack-neutron-host-prep-marker"
      ],
      "timeout_seconds": 1200
    },
    {
      "id": "validate-package-config-smoke",
      "action": "ssh.script.run",
      "transport": "bkc-ssh",
      "risk": "low",
      "with": {
        "hosts": "${dictionary.target_hosts}",
        "script": "${dictionary.validate_script}",
        "environment": {
          "BKC_OPENSTACK_SMOKE_MODE": "${dictionary.smoke_mode}",
          "BKC_NEUTRON_EXTERNAL_BRIDGE": "${dictionary.neutron_external_bridge}",
          "BKC_NEUTRON_PHYSNET": "${dictionary.neutron_physnet}"
        }
      },
      "produces": [
        "event:openstack_package_smoke.validation_passed",
        "node:validation_evidence"
      ],
      "timeout_seconds": 180
    },
    {
      "id": "record-smoke-evidence",
      "action": "node.relationships.record",
      "transport": "internal",
      "risk": "low",
      "with": {
        "relationships": [
          {
            "source_id": "${dictionary.target_node_id}",
            "type": "smoke_tested_for",
            "target_id": "platform:openstack",
            "confidence": "package-config-only"
          }
        ]
      },
      "produces": [
        "relationship:openstack-package-smoke"
      ],
      "timeout_seconds": 15
    }
  ],
  "notes": "This smoke lane can use foobar-crm-01 or a clone to test install/config mechanics. It should not be used as proof that the VM can run a useful OpenStack control or compute role."
}
