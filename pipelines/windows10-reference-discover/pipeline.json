{
  "format": "bkc-pipeline-v1",
  "id": "windows10-reference-discover",
  "name": "Windows 10 Reference Discover",
  "status": "draft",
  "owner": "bkc",
  "summary": "Preflight the Windows 10 ISO and VMID 113 reference target before building an unattended Windows lane.",
  "tags": [
    "bkc",
    "windows",
    "windows10",
    "unattended",
    "openssh",
    "preflight",
    "runnable"
  ],
  "targets": {
    "boot_image": "node:boot_image:windows10-22h2-english-x64",
    "reference_vm": "node:vm:win10-reference-113"
  },
  "inputs": {
    "windows_iso_path": {
      "required": true,
      "default": "/home/auzieman/Projects/Windows10_iso/Win10_22H2_English_x64v1.iso"
    },
    "proxmox_iso_volume": {
      "required": true,
      "default": "local:iso/Win10_22H2_English_x64.iso"
    },
    "reference_vmid": {
      "required": true,
      "default": 113
    },
    "reference_vm_ip": {
      "required": true,
      "default": "192.168.1.90"
    }
  },
  "gates": [
    {
      "id": "reference-only",
      "kind": "manual.approval",
      "with": {
        "intent": "Discover and stage assets only. Do not rebuild VMID 113."
      }
    }
  ],
  "stages": [
    {
      "id": "verify-iso",
      "action": "artifact.iso.verify",
      "transport": "local",
      "risk": "low",
      "with": {
        "path": "${dictionary.windows_iso_path}",
        "name": "${dictionary.windows_iso_name}",
        "proxmox_volume": "${dictionary.proxmox_iso_volume}"
      },
      "produces": [
        "fact:windows_iso"
      ],
      "timeout_seconds": 120
    },
    {
      "id": "inspect-vm113",
      "action": "proxmox.vm.inspect",
      "transport": "bkc-proxmox",
      "risk": "low",
      "with": {
        "vmid": "${dictionary.reference_vmid}",
        "name": "${dictionary.reference_vm_name}"
      },
      "produces": [
        "fact:vm113_config"
      ],
      "timeout_seconds": 60
    },
    {
      "id": "validate-openssh",
      "action": "ssh.command.check",
      "transport": "bkc-ssh",
      "risk": "low",
      "with": {
        "target": "${dictionary.reference_vm_ip}",
        "user": "${dictionary.reference_vm_user}",
        "command": "hostname"
      },
      "produces": [
        "fact:windows_ssh_ready"
      ],
      "timeout_seconds": 30
    },
    {
      "id": "stage-firstboot-artifacts",
      "action": "artifact.stage",
      "transport": "internal",
      "risk": "low",
      "with": {
        "bootstrap_script": "${dictionary.bootstrap_script}",
        "diet_script": "${dictionary.diet_script}"
      },
      "produces": [
        "artifact:install-bkc-openssh-key",
        "artifact:windows10-base-diet"
      ],
      "timeout_seconds": 15
    },
    {
      "id": "record-windows-relationships",
      "action": "node.relationships.record",
      "transport": "internal",
      "risk": "low",
      "with": {
        "relationships": [
          {
            "source_id": "${dictionary.reference_vm_node_id}",
            "type": "uses_boot_image",
            "target_id": "${dictionary.windows_iso_node_id}",
            "confidence": "declared"
          },
          {
            "source_id": "${dictionary.reference_vm_node_id}",
            "type": "managed_through",
            "target_id": "node:service:openssh",
            "confidence": "validated"
          }
        ]
      },
      "produces": [
        "relationship:win10-reference-uses-iso",
        "relationship:win10-reference-openssh"
      ],
      "timeout_seconds": 15
    }
  ]
}
