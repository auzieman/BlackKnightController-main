{
  "format": "bkc-pipeline-v1",
  "id": "ns1-provisioning-dhcp-prepare",
  "name": "ns1 Provisioning DHCP Prepare",
  "status": "draft",
  "owner": "bkc",
  "summary": "Render and validate DHCP service configuration for ns1's isolated provisioning network without serving DHCP by default.",
  "tags": [
    "bkc",
    "node-model",
    "provisioning",
    "network",
    "dhcp",
    "ns1",
    "pxe-prep"
  ],
  "targets": {
    "controller": "node:vm:ns1",
    "provisioning_network": "node:network:lab-provisioning",
    "dhcp_service": "node:service:ns1-dhcpd"
  },
  "inputs": {
    "target_node_id": {
      "required": true,
      "default": "node:vm:ns1"
    },
    "target_host": {
      "required": true,
      "default": "ns1.lab.auzietek.com"
    },
    "provisioning_interface": {
      "required": true,
      "default": ""
    },
    "enable_dhcp_service": {
      "required": false,
      "default": false
    }
  },
  "gates": [
    {
      "id": "provisioning-interface-required",
      "kind": "network.interface.boundary",
      "with": {
        "target": "${inputs.target_host}",
        "interface": "${inputs.provisioning_interface}",
        "cidr": "${dictionary.provisioning_network_cidr}"
      }
    },
    {
      "id": "management-network-not-served",
      "kind": "network.dhcp.boundary",
      "with": {
        "forbidden_cidr": "192.168.1.0/24",
        "allow_management_interface": false
      }
    },
    {
      "id": "service-disabled-by-default",
      "kind": "manual.approval",
      "with": {
        "default": "${dictionary.enable_dhcp_service}",
        "requires_explicit_true": true
      }
    }
  ],
  "stages": [
    {
      "id": "resolve-ns1-node",
      "action": "node.resolve",
      "transport": "internal",
      "risk": "low",
      "with": {
        "node_id": "${inputs.target_node_id}",
        "fallback_host": "${inputs.target_host}"
      },
      "produces": [
        "fact:target_node"
      ],
      "timeout_seconds": 15
    },
    {
      "id": "verify-provisioning-network",
      "action": "ssh.network.validate_management",
      "transport": "bkc-ssh",
      "risk": "low",
      "with": {
        "target": "${inputs.target_host}",
        "interface": "${inputs.provisioning_interface}",
        "provisioning_cidr": "${dictionary.provisioning_network_cidr}",
        "check": "checks/validate-dhcp-boundary.sh"
      },
      "produces": [
        "fact:dhcp_network_boundary"
      ],
      "timeout_seconds": 30
    },
    {
      "id": "ensure-dhcp-include",
      "action": "ssh.file.ensure_line",
      "transport": "bkc-ssh",
      "risk": "medium",
      "with": {
        "target": "${inputs.target_host}",
        "path": "${dictionary.dhcp_config_path}",
        "line": "${dictionary.dhcp_include_line}",
        "create": true,
        "backup": true
      },
      "produces": [
        "fact:dhcp_main_config_includes_bkc_fragment"
      ],
      "timeout_seconds": 30
    },
    {
      "id": "render-dhcp-fragment",
      "action": "template.render",
      "transport": "internal",
      "risk": "low",
      "with": {
        "template": "templates/dhcpd.conf.tpl",
        "target_path": "${dictionary.dhcp_fragment_path}"
      },
      "produces": [
        "artifact:bkc-provisioning-dhcp-fragment"
      ],
      "timeout_seconds": 15
    },
    {
      "id": "render-dhcp-defaults",
      "action": "template.render",
      "transport": "internal",
      "risk": "low",
      "with": {
        "template": "templates/isc-dhcp-server.defaults.tpl",
        "target_path": "${dictionary.dhcp_defaults_path}"
      },
      "produces": [
        "artifact:isc-dhcp-server-defaults"
      ],
      "timeout_seconds": 15
    },
    {
      "id": "install-dhcp-package",
      "action": "ssh.package.ensure",
      "transport": "bkc-ssh",
      "risk": "medium",
      "with": {
        "target": "${inputs.target_host}",
        "package": "${dictionary.dhcp_package}"
      },
      "produces": [
        "fact:dhcp_package"
      ],
      "timeout_seconds": 180
    },
    {
      "id": "validate-dhcp-config",
      "action": "ssh.command.check",
      "transport": "bkc-ssh",
      "risk": "low",
      "with": {
        "target": "${inputs.target_host}",
        "command": "test -d ${dictionary.dhcp_include_dir} && test -f ${dictionary.dhcp_fragment_path} && grep -F '${dictionary.dhcp_include_line}' ${dictionary.dhcp_config_path} && dhcpd -t -cf ${dictionary.dhcp_config_path}"
      },
      "produces": [
        "fact:dhcp_config_valid"
      ],
      "timeout_seconds": 30
    },
    {
      "id": "keep-dhcp-disabled",
      "action": "ssh.service.disabled",
      "transport": "bkc-ssh",
      "risk": "low",
      "with": {
        "target": "${inputs.target_host}",
        "service": "${dictionary.dhcp_service_name}",
        "unless": "${dictionary.enable_dhcp_service}"
      },
      "produces": [
        "fact:dhcp_service_disabled"
      ],
      "timeout_seconds": 30
    },
    {
      "id": "record-dhcp-relationships",
      "action": "node.relationships.record",
      "transport": "internal",
      "risk": "low",
      "with": {
        "relationships": [
          {
            "source_id": "${dictionary.dhcp_service_node_id}",
            "type": "serves",
            "target_id": "${dictionary.provisioning_network_node_id}",
            "confidence": "declared"
          },
          {
            "source_id": "${inputs.target_node_id}",
            "type": "hosts",
            "target_id": "${dictionary.dhcp_service_node_id}",
            "confidence": "declared"
          }
        ]
      },
      "produces": [
        "relationship:ns1-hosts-dhcpd",
        "relationship:dhcpd-serves-provisioning-network"
      ],
      "timeout_seconds": 15
    }
  ]
}
